node_modules/
dist/
# ANCHORED. An unanchored `data/` also matches `client/data/` — the buhur
# tables, the flavour أبيات and the keymap — and silently kept four source
# files out of the repository.
/data/
# ANCHORED and whole-directory: `screenshots/*.png` matched only the top level,
# so every subfolder a smoke run writes (`--out screenshots/<name>`) was
# untracked-but-not-ignored and `git add -A` would have committed 30 PNGs.
/screenshots/
.env

# ─── Capacitor / Android (docs/roadmap-mobile.md §M1) ───────────────────────
# Commit the android/ project SOURCES like a normal Capacitor repo, but never
# the heavy build outputs, the generated web-asset copy, or any signing secret.
/android/.gradle/
/android/build/
/android/app/build/
/android/captures/
/android/local.properties
/android/.idea/
# Regenerated by `npx cap sync` from dist/ + the plugin list — not source.
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
# Signing: the keystore lives OUTSIDE the repo; its passwords never land here.
/android/keystore.properties
*.keystore
*.jks

{
  "name": "qarid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "قريض — Arabic classical poetry corpus browser + مساجلة duel",
  "scripts": {
    "dev": "vite --port 5751 --strictPort",
    "dev:server": "PORT=5750 node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 6750 --strictPort",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node tools/screenshot.mjs",
    "ingest": "node --env-file-if-exists=.env scripts/ingest/index.ts build",
    "ingest:fetch": "node scripts/ingest/index.ts fetch",
    "ingest:fixture": "node scripts/ingest/index.ts fixture",
    "ingest:stats": "node scripts/ingest/index.ts stats"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "hyparquet": "^1.29.1",
    "hyparquet-compressors": "^1.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}

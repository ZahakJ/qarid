# Copy to .env and adjust. The server reads this via --env-file-if-exists.

# Where the tunnel points. Prod is 8010 (Cloudflare ingress); dev API uses 5750.
HOST=127.0.0.1
PORT=8010

# Absolute URLs (share cards, OpenGraph) are built from this.
PUBLIC_ORIGIN=https://qarid.example.com

# The built corpus database (read-only at runtime). Defaults to ./data/qarid.db.
#DB_PATH=/path/to/qarid/data/qarid.db

# ── الحسابات (v2.md §4) ────────────────────────────────────────────────────
# The ONE writable database: accounts, sessions and مساجلة rooms. Created on
# first boot; the corpus above stays read-only. A read-only directory is not a
# crash — the server logs one line and /api/auth/* answers 503.
#USERS_DB_PATH=/path/to/qarid/data/qarid-users.db

# Registration is OPEN by default. Set REQUIRE_INVITE=1 to close it, and list
# the codes that open it again (comma-separated). REQUIRE_INVITE=1 with an
# empty INVITE_CODES means nobody can register at all.
#REQUIRE_INVITE=1
#INVITE_CODES=code-one,code-two

# UGC moderation (Track 3). Accounts allowed to reach /api/admin/* — the report
# queue, remove-avatar, reset-display-name, suspend/unsuspend. Comma-separated,
# case-insensitive. UNSET means no account is an admin and every /api/admin/*
# route answers 403.
#ADMIN_USERNAMES=owner,someone-else

# ── The Android/native build only ─────────────────────────────────────────
# The native shell talks to your deployment cross-origin, so it has to be told
# where that is at BUILD time. There is no default: unset, the shell logs an
# error and every request fails, which beats quietly talking to a placeholder.
#
# NOTE: Vite's root is `client/`, so it does NOT read this file. Pass it on the
# command line when you build for the app:
#
#   VITE_API_BASE=https://your.host npm run build
#   QARID_APP_ID=com.your.package npx cap sync android
#
# VITE_API_BASE=https://your.host

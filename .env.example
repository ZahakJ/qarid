# Copy to .env and adjust. The server reads this via --env-file-if-exists.

# Where the tunnel points. Prod is 8010 (Cloudflare ingress); dev API uses 5750.
HOST=127.0.0.1
PORT=8010

# Absolute URLs (share cards, OpenGraph) are built from this.
PUBLIC_ORIGIN=https://qarid.avicenna.space

# The built corpus database (read-only at runtime). Defaults to ./data/qarid.db.
#DB_PATH=/home/avicenna/Documents/side/qarid/data/qarid.db

# ── الحسابات (v2.md §4) ────────────────────────────────────────────────────
# The ONE writable database: accounts, sessions and مساجلة rooms. Created on
# first boot; the corpus above stays read-only. A read-only directory is not a
# crash — the server logs one line and /api/auth/* answers 503.
#USERS_DB_PATH=/home/avicenna/Documents/side/qarid/data/qarid-users.db

# Registration is OPEN by default. Set REQUIRE_INVITE=1 to close it, and list
# the codes that open it again (comma-separated). REQUIRE_INVITE=1 with an
# empty INVITE_CODES means nobody can register at all.
#REQUIRE_INVITE=1
#INVITE_CODES=code-one,code-two
